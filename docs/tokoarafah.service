[Unit]
Description=Toko Arafah Kasir Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=tokoarafah
WorkingDirectory=/opt/tokoarafah
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tokoarafah/venv/bin/python /opt/tokoarafah/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
